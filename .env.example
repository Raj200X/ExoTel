# =============================================================================
# meta-NFS Configuration Environment Variables
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# --- General & App Settings ---
ENV=development                    # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-this-to-a-secure-random-string

# --- LLM Provider (Google Gemini) ---
# Required for Fast Model (Gemini Flash), Deep Model (Gemini Pro), and Vision (Docs)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Vector Database & Storage (PostgreSQL + pgvector) ---
# Required for Knowledge Base retrieval (statute chunks + embeddings)
DATABASE_URL=postgresql://user:password@localhost:5432/metanfs_db

# --- Session State Store (Redis) ---
# Required for distributed session state, turn history, and locks
REDIS_URL=redis://localhost:6379/0

# --- Telephony Integration (Exotel - India) ---
# Required for live incoming voice call handling
EXOTEL_ACCOUNT_SID=your_exotel_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_VIRTUAL_NUMBER=your_toll_free_number

# --- Indic Speech Integration (Bhashini / Dhruva - Hindi/Indic ASR & TTS) ---
# Required for voice STT/TTS in Hindi & regional languages
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_ID=your_pipeline_id

# --- English Speech Integration (Deepgram) ---
# Required for English ASR fallback
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- Scope Gate & Configuration Paths ---
SCOPE_GATE_RULES_DIR=config/scope_gate_rules
ROUTING_TABLES_DIR=config/routing_tables
