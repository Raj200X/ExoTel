# =============================================================================
# Saarthi — Configuration Environment Variables
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# --- General & App Settings ---
ENV=development                    # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-this-to-a-secure-random-string

# --- LLM Provider (Google Gemini) ---
# Used for post-call transcript analysis (summary, topic, risk, action items)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Vapi ---
# API key for Vapi webhook validation and API calls
# Get this from https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_api_key_here

# --- Lifeline AI Phone Number ---
# The real phone number configured in Vapi that users call
SAARTHI_PHONE_NUMBER=+91-XXXXXXXXXX

# --- Database ---
# PostgreSQL database URL
DATABASE_URL=postgresql://user:password@localhost:5432/lifeline_db

# --- Speech Stack Integration (Alternatives to Bhashini: Google STT/TTS, Sarvam, Deepgram) ---
# Supported providers: google | sarvam | deepgram
SPEECH_PROVIDER=google
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
SARVAM_API_KEY=your_sarvam_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- Scope Gate & Configuration Paths ---
SCOPE_GATE_RULES_DIR=config/scope_gate_rules
ROUTING_TABLES_DIR=config/routing_tables

# --- Server Settings ---
HOST=0.0.0.0
PORT=8000

# --- Model Name ---
MODEL_NAME=gemini-2.0-flash
